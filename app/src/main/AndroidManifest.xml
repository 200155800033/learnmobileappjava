<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Eduapp"
        tools:ignore="ExtraText"
        tools:targetApi="31">
        <activity
            android:name=".QuizActivity"
            android:exported="false" />
        <!-- Activities to launch -->
        <activity
            android:name=".EbooksActivity"
            android:exported="true" /> <!-- Set exported to true -->
        <activity
            android:name=".AllcourseActivity"
            android:exported="true" /> <!-- Set exported to true -->
        <activity
            android:name=".HomeActivity"
            android:exported="false" /> <!-- Home activity should be false -->
        <!-- MainActivity (Launcher Activity) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- Other activities (should stay false) -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />
        <activity
            android:name=".SignUpActivity"
            android:exported="false" />
        <activity
            android:name=".ForgetPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".GetStartedActivity"
            android:exported="false" />
    </application>

</manifest>