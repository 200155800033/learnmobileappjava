<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".QuizActivity">

    <TextView
        android:id="@+id/question_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="What is the capital of France?"
        android:textSize="18sp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <RadioGroup
        android:id="@+id/answers_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/question_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RadioButton
            android:id="@+id/answer_1_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Berlin" />

        <RadioButton
            android:id="@+id/answer_1_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Madrid" />

        <RadioButton
            android:id="@+id/answer_1_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paris" />
    </RadioGroup>


    <TextView
        android:id="@+id/question_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="What is the largest planet in our solar system?"
        android:textSize="18sp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/answers_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <RadioGroup
        android:id="@+id/answers_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/question_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RadioButton
            android:id="@+id/answer_2_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Earth" />

        <RadioButton
            android:id="@+id/answer_2_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jupiter" />

        <RadioButton
            android:id="@+id/answer_2_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mars" />
    </RadioGroup>


    <TextView
        android:id="@+id/question_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Which language is primarily used for Android development?"
        android:textSize="18sp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/answers_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <RadioGroup
        android:id="@+id/answers_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/question_3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RadioButton
            android:id="@+id/answer_3_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Python" />

        <RadioButton
            android:id="@+id/answer_3_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Java" />

        <RadioButton
            android:id="@+id/answer_3_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="C++" />
    </RadioGroup>

</androidx.constraintlayout.widget.ConstraintLayout>
